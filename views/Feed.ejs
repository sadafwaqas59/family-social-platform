<!DOCTYPE html>
<html>
<head>
  <title>Family Feed</title>

  <!-- Bootstrap for styling -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background-color: #f0f2f5; } /* light grey background like Facebook */
    .card { border-radius: 10px; } /* smooth rounded cards */
    .navbar { background-color: #1877f2; } /* Facebook blue navbar */
    .navbar h4 { color: white; } /* white text in navbar */
  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar p-3">
  <div class="container">
    <h4>Family Social</h4> <!-- app title -->
    <a href="/logout" class="btn btn-light btn-sm">Logout</a> <!-- logout button -->
  </div>
</nav>

<div class="container mt-4">

  <!-- CREATE POST -->
  <div class="card p-3 mb-4 shadow-sm">
    <form method="POST" action="/post/create" class="d-flex gap-2"> <!-- post form -->
      <input 
        type="text" 
        name="content" 
        class="form-control" 
        placeholder="What's on your mind?" 
        required
      > <!-- input for post -->
      <button class="btn btn-primary">Post</button> <!-- submit post -->
    </form>
  </div>

  <!-- IF NO POSTS -->
  <% if (posts.length === 0) { %>
    <p class="text-center text-muted">No posts yet</p> <!-- empty message -->
  <% } %>

  <!-- POSTS LOOP -->
  <% posts.forEach(post => { %>
    
    <div class="card mb-3 shadow-sm p-3">

      <!-- USER INFO -->
      <div class="d-flex align-items-center mb-2">
        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center" 
             style="width:40px;height:40px;">
          <%= post.userId?.name.charAt(0).toUpperCase() %> 
        </div> <!-- user avatar with first letter -->

        <div class="ms-2">
          <strong><%= post.userId?.name %></strong> <!-- show username -->
        </div>
      </div>

      <!-- POST CONTENT -->
      <p><%= post.content %></p> <!-- display post text -->

      <!-- LIKE BUTTON -->
      <div>
        <a href="/post/like/<%= post._id %>" class="btn btn-light btn-sm">
          👍 Like (<%= post.likes.length %>)
        </a> <!-- like button with count -->
      </div>

    </div>

  <% }) %>

</div>

</body>
</html>