<!DOCTYPE html>
<html>
<head>
  <title>Expenses</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">

<h2>💰 Family Expenses</h2> <!--  title -->

<form action="/expenses/create" method="POST" class="mb-3">
  <input name="title" placeholder="Title" required> <!--  title -->
  <input name="amount" type="number" placeholder="Amount" required> <!-- amount -->
  <button class="btn btn-primary">Add</button> <!--  add -->
</form>

<h4>💵 Family Total: Rs <%= total %></h4> <!-- total -->

<hr>

<h5>👤 My Expenses</h5>

<ul class="list-group mb-3">
  <% myExpenses.forEach(e => { %> <!-- user loop -->
    <li class="list-group-item d-flex justify-content-between">
      <span><%= e.title %> - Rs <%= e.amount %></span> <!--  show -->

      <div>
        <a href="/expenses/edit/<%= e._id %>" class="btn btn-warning btn-sm">Edit</a> <!--  edit -->
        <form action="/expenses/delete/<%= e._id %>" method="POST" style="display:inline;">
          <button class="btn btn-danger btn-sm">Delete</button> <!-- delete -->
        </form>
      </div>

    </li>
  <% }) %>
</ul>

<h5>🏠 All Family Expenses</h5>

<ul class="list-group">
  <% expenses.forEach(e => { %> <!--  all expenses -->
    <li class="list-group-item">
      <%= e.title %> - Rs <%= e.amount %>
    </li>
  <% }) %>
</ul>

</body>
</html>