<!DOCTYPE html>
<html>
<head>
  <title>POSTS</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f0f2f5; } /* facebook bg */
    .card { border-radius:12px; } /* smooth card */
    .feed { max-width:600px; margin:auto; } /* center feed */
    img { border-radius:10px; } /* rounded image */
  </style>
</head>

<body>

<div class="feed mt-4">

  <!-- CREATE POST -->
  <div class="card p-3 mb-3 shadow-sm">
    <form method="POST" action="/post/create" enctype="multipart/form-data">
      <input type="text" name="content" class="form-control mb-2" placeholder="What's on your mind?" required> <!-- text -->
      <input type="file" name="image" class="form-control mb-2"> <!-- image -->
      <button class="btn btn-primary w-100">Post</button> <!-- post btn -->
    </form>
  </div>

  <!-- POSTS -->
  <% posts.forEach(post => { %>

    <div class="card p-3 mb-3 shadow-sm">

      <!-- USER -->
      <strong><%= post.userId?.name %></strong>

      <!-- CONTENT -->
      <p><%= post.content %></p>

      <!-- IMAGE -->
      <% if (post.image) { %>
        <img src="<%= post.image %>" class="img-fluid mb-2">
      <% } %>

      <!-- LIKE -->
      <a href="/post/like/<%= post._id %>" class="btn btn-light btn-sm">
        👍 Like (<%= post.likes.length %>)
      </a>

      <hr>

      <!-- COMMENTS -->
      <% post.comments.forEach(c => { %>
        <p><strong><%= c.userId?.name %>:</strong> <%= c.text %></p>
      <% }) %>

      <!-- ADD COMMENT -->
      <form method="POST" action="/post/comment/<%= post._id %>">
        <input type="text" name="text" class="form-control" placeholder="Write a comment..." required>
      </form>

    </div>

  <% }) %>

</div>

</body>
</html>