<!DOCTYPE html>
<html>

<head>

  <title>Private Chat</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>

    body{
      background:#ece5dd;
    }

    .chat-box{
      max-width:700px;
      margin:auto;
      height:80vh;
      overflow-y:auto;
      padding:20px;
    }

    .sender{
      background:#dcf8c6;
      padding:10px;
      border-radius:10px;
      width:fit-content;
      margin-left:auto;
      margin-bottom:10px;
      max-width:70%;
    }

    .receiver{
      background:white;
      padding:10px;
      border-radius:10px;
      width:fit-content;
      margin-right:auto;
      margin-bottom:10px;
      max-width:70%;
    }

    .chat-form{
      max-width:700px;
      margin:auto;
      display:flex;
      gap:10px;
      padding:10px;
    }

  </style>

</head>

<body>


<h2 class="text-center mt-3">

  Chat with
  <%= otherUser.name %>

</h2>



<div class="chat-box">


  <% messages.forEach(message => { %>


    <!-- sender -->
    <% if (
      String(message.sender._id)
      ===
      String(currentUser._id)
    ) { %>

      <div class="sender">

        <strong>

          You

        </strong>

        <p class="mb-0">

          <%= message.text %>

        </p>

      </div>


    <!-- receiver -->
    <% } else { %>

      <div class="receiver">

        <strong>

          <%= otherUser.name %>

        </strong>

        <p class="mb-0">

          <%= message.text %>

        </p>

      </div>

    <% } %>


  <% }) %>


</div>



<form
  action="/messages/send/<%= otherUser._id %>"
  method="POST"
  class="chat-form"
>

  <input
    type="text"
    name="text"
    class="form-control"
    placeholder="Write message..."
    required
  >

  <button class="btn btn-success">

    Send

  </button>

</form>


</body>
</html>