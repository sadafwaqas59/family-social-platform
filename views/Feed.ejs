<!DOCTYPE html>
<html>

<head>

  <title>POSTS</title>
  <!-- browser page title -->


  <!-- bootstrap css -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >


  <style>

    body {
      background:#f0f2f5;
    }
    /* facebook background */


    .card {
      border-radius:12px;
    }
    /* rounded cards */


    .feed {
      max-width:600px;
      margin:auto;
    }
    /* center feed */


    img {
      border-radius:10px;
    }
    /* rounded images */

  </style>

</head>



<body>


<div class="feed mt-4">


  <!-- ================= CREATE POST ================= -->
  <div class="card p-3 mb-3 shadow-sm">

    <form
      method="POST"
      action="/post/create"
      enctype="multipart/form-data"
    >

      <!-- post text -->
      <input
        type="text"
        name="content"
        class="form-control mb-2"
        placeholder="What's on your mind?"
        required
      >


      <!-- upload image -->
      <input
        type="file"
        name="image"
        class="form-control mb-2"
      >


      <!-- submit button -->
      <button class="btn btn-primary w-100">

        Post

      </button>

    </form>

  </div>



  <!-- ================= POSTS LOOP ================= -->
  <% posts.forEach(post => { %>

    <div class="card p-3 mb-3 shadow-sm">


      <!-- user name -->
      <strong>

        <%= post.userId?.name %>

      </strong>


      <!-- post text -->
      <p>

        <%= post.content %>

      </p>



      <!-- show image -->
      <% if (post.image) { %>

        <img
          src="<%= post.image %>"
          class="img-fluid mb-2"
        >

      <% } %>



      <!-- ================= LIKE BUTTON ================= -->
      <form
        method="POST"
        action="/post/like/<%= post._id %>"
      >

        <button class="btn btn-light btn-sm">

          👍 Like
          (
          <%= post.likes ? post.likes.length : 0 %>
          )

        </button>

      </form>



      <hr>



      <!-- ================= COMMENTS LIST ================= -->
      <% if (post.comments) { %>

        <% post.comments.forEach(c => { %>

          <p>

            <strong>

              <%= c.userId?.name || "User" %>:

            </strong>

            <%= c.text %>

          </p>

        <% }) %>

      <% } %>



      <!-- ================= ADD COMMENT ================= -->
      <form
        method="POST"
        action="/post/comment/<%= post._id %>"
      >

        <!-- comment input -->
        <input
          type="text"
          name="text"
          class="form-control mb-2"
          placeholder="Write a comment..."
          required
        >


        <!-- comment button -->
        <button class="btn btn-primary btn-sm w-100">

          Comment

        </button>

      </form>


    </div>

  <% }) %>


</div>


</body>
</html>