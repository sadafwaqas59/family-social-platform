<!DOCTYPE html>
<html>
<head>
  <title>Edit Expense</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">

<h2> Edit Expense</h2>

<form action="/expenses/update/<%= expense._id %>" method="POST">
  <input name="title" value="<%= expense.title %>" required> <!--  title -->
  <input name="amount" type="number" value="<%= expense.amount %>" required> <!-- amount -->
  <button class="btn btn-success">Update</button> <!-- update -->
</form>

</body>
</html>